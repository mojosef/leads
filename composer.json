{
    "name": "mojosef/leads",
    "description": "Durable, queue-backed lead pipeline shared across the Duo CRM site fleet.",
    "keywords": [
        "Joe Hodgson",
        "laravel",
        "leads",
        "duo"
    ],
    "homepage": "https://github.com/mojosef/leads",
    "license": "MIT",
    "authors": [
        {
            "name": "Joe Hodgson",
            "email": "joe@whiterabbitdigital.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "esign/laravel-conversions-api": "^2.5",
        "giggsey/libphonenumber-for-php-lite": "^8.13",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/database": "^11.0||^12.0||^13.0",
        "illuminate/http": "^11.0||^12.0||^13.0",
        "illuminate/queue": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "mojosef\\Leads\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "mojosef\\Leads\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "mojosef\\Leads\\LeadsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
